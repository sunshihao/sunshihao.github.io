---
import Base from '../layouts/Base.astro';
import manifest from '../data/manifest.json';

const issues = manifest;
---
<Base title="见闻周刊 · 总目录">
<div class="wrap">
  <div class="kicker">硬来源 · 每周五发布</div>
  <h1>见闻周刊</h1>
  <p class="lede">把一周的硬消息压成一篇能读完的东西：政治、财经、科技、AI、国内股市、期货，每期 60 条，正文 18 条。
  每条都带明文 URL 与逐字引用，数字可以在原文里核对。</p>
  <p class="meta-row"><span>{issues.length} 期</span><span>T1 官方 / T2 通讯社 / T3 垂直</span><span>来源属地与时间窗机器校验</span></p>
  <div class="cards">
    {issues.map((it) => (
      <div class="card">
        <div class="thumb"><img src={`/${it.cover}`} alt="" /></div>
        <div class="body">
          <div class="sub">{it.date}　{it.stats}</div>
          <h3>{it.title.replace(/^见闻周刊（[^）]*）：/, '')}</h3>
          <p class="excerpt">{it.summary}</p>
          <div class="sub"><a href={`/issues/${it.id}/`}>读这一期 →</a></div>
        </div>
        <a class="stretch" href={`/issues/${it.id}/`}>阅读</a>
      </div>
    ))}
  </div>
</div>
</Base>
