---
import { cssVersion, SITE } from '../lib/render.mjs';
import fs from 'node:fs';
import path from 'node:path';

const {
  title = '见闻周刊',
  description = '每周一期的硬来源新闻周刊：60 条，正文 18 条，数字可在原文核对。',
  ogImage = '',
  canonical = '/',
  comments = false,
  bodyClass = '',
} = Astro.props;

const siteCfgPath = path.join(process.cwd(), 'public/assets/data/site.json');
const siteCfg = fs.existsSync(siteCfgPath) ? JSON.parse(fs.readFileSync(siteCfgPath, 'utf8')) : null;
const og = ogImage.startsWith('http') ? ogImage : SITE + (ogImage || '/assets/img/brand/og.png');
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#fbfaf7">
<title>{title}</title>
<link rel="icon" href="/assets/img/brand/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/brand/apple-touch-icon.png">
<link rel="stylesheet" href={`/assets/css/site.css?v=${cssVersion}`}>
<noscript><style>.search-btn{display:none}</style></noscript>
<link rel="alternate" type="application/rss+xml" title="见闻周刊 · RSS" href={`${SITE}/rss.xml`}>
<meta property="og:type" content="article">
<meta property="og:site_name" content="见闻周刊">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={SITE + canonical}>
<meta property="og:image" content={og}>
<meta name="twitter:card" content="summary_large_image">
<script is:inline>try{var t=localStorage.getItem('sw-theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}</script>
</head>
<body id="top" class={bodyClass}>
<div class="topbar">
  <a class="brand" href="/"><img class="brand-mark" src="/assets/img/brand/icon.svg" alt="" width="22" height="22">见闻周刊<span>硬来源 · 每周</span></a>
  <div class="spacer"></div>
  <button class="btn search-btn" type="button" data-search-open aria-label="搜索全站" aria-keyshortcuts="Meta+K Control+K" title="搜索（⌘K / Ctrl+K）">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <span>搜索</span>
  </button>
  <button class="btn" type="button" data-theme-toggle onclick="toggleTheme()">☾ 夜间</button>
</div>
<slot />
<a class="to-top" href="#top" data-to-top aria-label="返回顶部" title="返回顶部">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
</a>
<dialog class="search-dialog" data-search aria-label="全站搜索">
  <div class="search-field">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input type="search" data-search-input placeholder="搜索标题或正文…" autocomplete="off" spellcheck="false" aria-label="搜索标题或正文">
    <button class="search-close" type="button" data-search-close aria-label="关闭搜索">Esc</button>
  </div>
  <div class="search-results" data-search-results></div>
</dialog>
<footer><div class="wrap">
<p><img class="brand-mark" src="/assets/img/brand/icon.svg" alt="" width="18" height="18" style="display:inline-block;vertical-align:-4px;margin-right:.5rem">见闻周刊 · 每条新闻带明文 URL 与逐字引用，数字可在原文核对。　<a href="/rss.xml">RSS 订阅</a></p>
<p>内容按 <a href="https://creativecommons.org/licenses/by-nc-nd/3.0/deed.zh" target="_blank" rel="noopener">CC BY-NC-ND 3.0</a> 授权。新闻图片版权归原机构，仅作摘要引用并给出原链路。</p>
</div></footer>
{comments && siteCfg && (
  <script is:inline set:html={`window.SITE_COMMENTS = ${JSON.stringify(siteCfg)};`} />
)}
{comments && <script is:inline src="/assets/js/comments.js"></script>}
<script is:inline src={`/assets/js/theme.js?v=${cssVersion}`}></script>
<script is:inline src={`/assets/js/back-to-top.js?v=${cssVersion}`}></script>
<script is:inline src={`/assets/js/search.js?v=${cssVersion}`}></script>
</body>
</html>
